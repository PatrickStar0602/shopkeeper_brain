# ====================
# 使用方式：复制本文件为 .env，填入你自己的值
# 注意：真实的 .env 已被 .gitignore 排除，不要提交
# 也可以把敏感项（密钥/密码）配到系统环境变量里，优先级高于 .env
# ====================

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
OPENAI_API_KEY=sk-your-dashscope-api-key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=qwen3.7-flash
ITEM_MODEL=qwen-flash
KG_MODEL=qwen-flash

# ====================
# BGE Embedding / Reranker
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=D:/ai_models/bge-m3
# cuda:0 或 cpu
BGE_DEVICE=cuda:0
BGE_FP16=True
# bge-reranker-large 模型本地路径
BGE_RERANKER_LARGE=D:/ai_models/bge-reranker-large
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_FP16=True
ITEM_NAME_DIAG=1

# ====================
# Embedding General
# ====================
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks_v1
ITEM_NAME_COLLECTION=kb_item_names_v1
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Document Database (MongoDB)
# ====================
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-v1

# ====================
# MCP Web Search
# ====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MCP_DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ====================
# Model Source & Cache
# ====================
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/hf_home
MD_ROOT_DIR=./temp-files/

# ====================
# Graph Database (Neo4j)
# ====================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ====================
# Rerank
# ====================
RERANK_MAX_TOP_K=10
RERANK_MIN_TOP_K=3
RERANK_GAP_RATIO=0.25
RERANK_GAP_ABS=0.15
